---
import "../styles/global.css";
import Socials from "../components/Socials.astro";
import Logo from "../assets/all1ndev.svg";
import { SITE_DESCRIPTION, SITE_NAME, SITE_TITLE } from "../consts";

interface Props {
	title?: string;
	description?: string;
	// Shorter description for social previews; defaults to `description`.
	ogDescription?: string;
	// Path relative to the site root, e.g. "og/2021-05-10-slug.jpg".
	ogImage?: string;
	ogType?: "website" | "article";
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	ogDescription = description,
	ogImage,
	ogType = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage ?? "og.jpg", Astro.site);
---

<!doctype html>
<html lang="en" class="motion-safe:scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="canonical" href={canonicalURL} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={SITE_NAME}
			href={new URL("rss.xml", Astro.site)}
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content="all1n.dev" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={ogImageURL} />

		{import.meta.env.PROD && (
			<script
				is:inline
				defer
				src="https://cloud.umami.is/script.js"
				data-website-id="f9d5680d-10cd-400f-b155-79121e4384e5"
			/>
		)}
	</head>
	<body class="bg-hexagon-pattern min-h-screen bg-green-900 p-4 text-white">
		<main class="mx-auto max-w-3xl rounded-lg bg-gray-800/50 shadow-sm outline -outline-offset-1 outline-white/10">
			<div class="border-b border-white/10 p-6">
				<div class="flex flex-wrap items-center justify-between gap-6 sm:flex-nowrap">
					<div class="flex grow items-center">
						<a class="shrink-0" href="/">
							<Logo
								class="size-16 rounded-2xl outline -outline-offset-1 outline-white/10"
								role="img"
								aria-label="All In Developer Logo"
							/>
						</a>
						<div class="ml-4">
							<h3 class="text-base font-semibold">
								<a href="/">all1n.dev</a>
							</h3>
							<p class="text-sm text-gray-400">
								<a href="https://github.com/all1ndev/">
									❤️&nbsp;&nbsp;<code>All In Developer</code>
								</a>
							</p>
						</div>
					</div>
					<Socials />
				</div>
			</div>

			<div>
				<slot />
			</div>
		</main>

		<div
			id="newsletter"
			class="mx-auto my-8 max-w-2xl scroll-mt-8 justify-center [&>form]:bg-transparent!"
		>
			<script
				is:inline
				async
				data-uid="01b922e572"
				src="https://all1n.kit.com/01b922e572/index.js"
			></script>
		</div>
	</body>
</html>
