---
import { Picture } from "astro:assets";
import "../styles/global.css";
import Gtag from "../components/gtag.html";
import Socials from "../components/Socials.astro";

interface Props {
	title?: string;
	description?: string;
	// Path relative to the site root, e.g. "og/2021-05-10-slug.png".
	ogImage?: string;
	ogType?: "website" | "article";
}

const {
	title = "All In Developer",
	description = "Full stack developer!",
	ogImage,
	ogType = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage ?? "avatar.jpg", Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content="all1n.dev" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
	</head>
	<body class="bg-hexagon-pattern min-h-screen bg-green-900 p-4 text-white">
		{import.meta.env.PROD && <Gtag />}
		<main
			class="mx-auto max-w-prose rounded-lg bg-gray-800/50 shadow-sm outline -outline-offset-1 outline-white/10"
		>
			<div class="border-b border-white/10 p-6">
				<div
					class="flex flex-wrap items-center justify-between gap-6 sm:flex-nowrap"
				>
					<div class="flex grow items-center">
						<a class="shrink-0" href="/">
							<Picture
								src="https://avatars.githubusercontent.com/u/67485880"
								width={256}
								height={256}
								class="size-16 rounded-2xl bg-gray-800 outline -outline-offset-1 outline-white/10"
								alt="All In Developer Logo"
							/>
						</a>
						<div class="ml-4">
							<h3 class="text-base font-semibold">
								<a href="/">all1n.dev</a>
							</h3>
							<p class="text-sm text-gray-400">
								<a href="https://github.com/all1ndev/">
									❤️&nbsp;&nbsp;<code>All In Developer</code>
								</a>
							</p>
						</div>
					</div>
					<Socials />
				</div>
			</div>

			<div>
				<slot />
			</div>
		</main>
	</body>
</html>
